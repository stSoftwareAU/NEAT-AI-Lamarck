# Ignore invisible
.*
*~
!.gitignore
!.gitattributes
!.github/
!.gitleaks.toml
!.codespellrc
!.markdownlint.json
!.markdownlintignore
!.markdownlint-cli2.yaml

/target/
**/*.rs.bk
.DS_Store

# NEAT-AI-core lives as a sibling clone. If a script ever checks it out
# inside the workspace as `NEAT-AI-core/` for Cargo path resolution, it
# must never be committed to this repo.
/NEAT-AI-core/
/NEAT-AI-core

# Lamarck runtime outputs (do not commit experiment artefacts).
/candidates/
/winners/
/best.json
/experiments.jsonl
**/observations.statistics
